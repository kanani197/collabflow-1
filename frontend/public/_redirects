# Netlify redirects file (copied into dist/ at build time since it lives in public/)
#
# IMPORTANT: replace the placeholder URL below with your actual deployed
# backend URL (e.g. from Render: https://collabflow-backend.onrender.com)
# before deploying, or set it via the BACKEND_URL environment variable in
# the Netlify UI and use netlify.toml instead (see docs/deployment.md).

/api/*  https://REPLACE_WITH_YOUR_BACKEND_URL.onrender.com/api/:splat  200

# SPA fallback: any other route serves index.html so React Router can
# handle client-side navigation (must come AFTER the /api/* rule above).
/*      /index.html   200
